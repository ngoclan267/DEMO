# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- LLM for Classification/Verification/Consensus/Pain Point agents (src/analysis/) ----
# Tổng cộng 6 key được luân phiên: 1 key chính (GEMINI_API_KEY) + 5 key bổ sung dưới đây (CSV,
# cách nhau bằng dấu phẩy, KHÔNG khoảng trắng thừa) — mỗi key là 1 tài khoản Google KHÁC NHAU để có
# 6 ngân sách quota RPM/TPM/RPD độc lập (xem GEMINI_MODEL_RPM trong src/analysis/llm.py). Hết quota
# key này tự chuyển sang key kế tiếp CÙNG model trước khi hạ xuống model dự phòng yếu hơn.
GEMINI_API_KEY=your-gemini-key-1-here
GEMINI_EXTRA_API_KEYS=your-gemini-key-2-here,your-gemini-key-3-here,your-gemini-key-4-here,your-gemini-key-5-here,your-gemini-key-6-here
# Dự phòng khi Gemini hết quota free-tier — tự động chuyển sang OpenAI (dùng chung OPENAI_API_KEY
# ở trên) nếu có cấu hình. Để trống thì Gemini vẫn là LLM duy nhất, không đổi hành vi.
OPENAI_ANALYSIS_MODEL_NAME=gpt-4o-mini

# ---- Apify ----
APIFY_API_TOKEN=your-apify-key-here

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Auth (JWT) ----
# Để trống sẽ tự sinh key ngẫu nhiên mỗi lần khởi động (chỉ phù hợp dev) — production nên đặt cố định.
SECRET_KEY=

# ---- Notification Service — Brevo (HTTP API, không dùng SMTP vì nhiều PaaS như Railway chặn) ----
# Lấy API key tại https://app.brevo.com/settings/keys/api — brevo_sender_email phải là địa chỉ đã
# "Verify a sender" trong Brevo dashboard (Senders, Domains & Dedicated IPs), nếu không Brevo từ
# chối gửi dù key đúng.
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-sender@example.com

# ---- Frontend base URL (dùng để build link reset-password trong email) ----
FRONTEND_BASE_URL=http://localhost:3000
# ---- Backend base URL công khai (dùng để build vnp_ReturnUrl cho VNPay) ----
BACKEND_BASE_URL=http://localhost:8000

# ---- Dùng thử + thanh toán VNPay ----
# Đăng ký merchant sandbox miễn phí tại https://sandbox.vnpayment.vn để lấy TmnCode/HashSecret test.
TRIAL_DURATION_DAYS=14
# Trần lượt gọi AI miễn phí TRỌN ĐỜI dùng thử — hết trần này thì khoá đăng nhập, yêu cầu nâng cấp.
TRIAL_ANALYSIS_CALL_LIMIT=1000
# Trần lượt gọi AI miễn phí TRONG 1 NGÀY (UTC) — tách biệt với trần trọn đời ở trên, chỉ tạm dừng
# phân tích thêm tới ngày mới, không khoá đăng nhập (xem trial_daily_call_limit trong src/config.py).
TRIAL_DAILY_CALL_LIMIT=50
SUBSCRIPTION_PRICE_VND=2000000
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Đổi sang https://pay.vnpay.vn/vpcpay.html khi triển khai thật (production).
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
